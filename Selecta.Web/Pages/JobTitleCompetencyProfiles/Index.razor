@page "/job-title-competency-profiles"
@attribute [Authorize]
@inject JobTitleCompetencyProfileApiClient JobTitleCompetencyProfileApi
@inject JobTitleApiClient JobTitleApi
@inject ISnackbar Snackbar

<PageTitle>Job Title Competency Profiles</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Job Title Competency Profiles</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    Perfil de competências esperadas para um <MudLink Href="/job-titles">Job Title</MudLink>.
</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           Class="mb-4" OnClick="@(() => OpenForm(null))" Disabled="_jobTitles is null || _jobTitles.Count == 0">
    New profile
</MudButton>

<RadzenDataGrid @ref="_grid" TItem="JobTitleCompetencyProfileDto" Data="@_items" Count="@_count" LoadData="@LoadDataAsync"
                AllowFiltering="true" AllowSorting="true" AllowPaging="true" PageSize="25"
                FilterMode="FilterMode.Simple" PageSizeOptions="@_pageSizeOptions">
    <Columns>
        <RadzenDataGridColumn TItem="JobTitleCompetencyProfileDto" Property="Name" Title="Name" />
        <RadzenDataGridColumn TItem="JobTitleCompetencyProfileDto" Property="JobTitleName" Title="Job Title" Sortable="false" Filterable="false" />
        <RadzenDataGridColumn TItem="JobTitleCompetencyProfileDto" Property="Active" Title="Active" Width="100px" />
        <RadzenDataGridColumn TItem="JobTitleCompetencyProfileDto" Sortable="false" Filterable="false" Width="120px" TextAlign="TextAlign.Center">
            <Template Context="profile">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenForm(profile))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(profile))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<MudDialog @bind-Visible="_showForm" Options="new DialogOptions { CloseOnEscapeKey = true }">
    <TitleContent>@(_editingProfile is null ? "New profile" : "Edit profile")</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Name" Class="mb-2" />
        <MudTextField @bind-Value="_description" Label="Description" Lines="2" Class="mb-2" />

        <RadzenDropDown TValue="Guid" @bind-Value="_jobTitleId" Data="@_jobTitles" TextProperty="Name" ValueProperty="Id"
                        AllowVirtualization="true" AllowFiltering="true" Placeholder="Job Title" Style="width:100%;" Class="mb-2" />

        @if (_editingProfile is not null)
        {
            <MudCheckBox @bind-Value="_active" Label="Active" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseForm">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private RadzenDataGrid<JobTitleCompetencyProfileDto>? _grid;
    private IEnumerable<JobTitleCompetencyProfileDto>? _items;
    private int _count;
    private readonly int[] _pageSizeOptions = [10, 25, 50, 100];
    private List<JobTitleDto>? _jobTitles;

    private bool _showForm;
    private JobTitleCompetencyProfileDto? _editingProfile;
    private string _name = string.Empty;
    private string? _description;
    private Guid _jobTitleId;
    private bool _active = true;

    protected override async Task OnInitializedAsync() => _jobTitles = await JobTitleApi.GetAllAsync();

    private async Task LoadDataAsync(LoadDataArgs args)
    {
        var pageSize = args.Top ?? 25;
        var page = pageSize > 0 ? (args.Skip ?? 0) / pageSize + 1 : 1;
        var paged = await JobTitleCompetencyProfileApi.GetPagedAsync(page, pageSize, args.Filter, args.OrderBy);
        _items = paged.Items;
        _count = paged.TotalCount;
    }

    private void OpenForm(JobTitleCompetencyProfileDto? profile)
    {
        _editingProfile = profile;
        _name = profile?.Name ?? string.Empty;
        _description = profile?.Description;
        _jobTitleId = profile?.JobTitleId ?? _jobTitles?.FirstOrDefault()?.Id ?? Guid.Empty;
        _active = profile?.Active ?? true;
        _showForm = true;
    }

    private void CloseForm() => _showForm = false;

    private async Task SaveAsync()
    {
        if (_editingProfile is null)
            await JobTitleCompetencyProfileApi.CreateAsync(new CreateJobTitleCompetencyProfileDto(_name, _description, _jobTitleId));
        else
            await JobTitleCompetencyProfileApi.UpdateAsync(new UpdateJobTitleCompetencyProfileDto(_editingProfile.Id, _name, _description, _jobTitleId, _active));

        Snackbar.Add("Profile saved.", Severity.Success);
        _showForm = false;
        await ReloadGridAsync();
    }

    private async Task DeleteAsync(JobTitleCompetencyProfileDto profile)
    {
        await JobTitleCompetencyProfileApi.DeleteAsync(profile.Id);
        Snackbar.Add("Profile deleted.", Severity.Success);
        await ReloadGridAsync();
    }

    private Task ReloadGridAsync() => _grid?.Reload() ?? Task.CompletedTask;
}
