@page "/professional-group-competency-profiles"
@attribute [Authorize]
@inject ProfessionalGroupCompetencyProfileApiClient ProfessionalGroupCompetencyProfileApi
@inject ProfessionalGroupApiClient ProfessionalGroupApi
@inject ISnackbar Snackbar

<PageTitle>Professional Group Competency Profiles</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Professional Group Competency Profiles</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    Perfil de competências esperadas para um <MudLink Href="/professional-groups">Professional Group</MudLink>.
</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           Class="mb-4" OnClick="@(() => OpenForm(null))" Disabled="_professionalGroups is null || _professionalGroups.Count == 0">
    New profile
</MudButton>

<RadzenDataGrid @ref="_grid" TItem="ProfessionalGroupCompetencyProfileDto" Data="@_items" Count="@_count" LoadData="@LoadDataAsync"
                AllowFiltering="true" AllowSorting="true" AllowPaging="true" PageSize="25"
                FilterMode="FilterMode.Simple" PageSizeOptions="@_pageSizeOptions">
    <Columns>
        <RadzenDataGridColumn TItem="ProfessionalGroupCompetencyProfileDto" Property="Name" Title="Name" />
        <RadzenDataGridColumn TItem="ProfessionalGroupCompetencyProfileDto" Property="ProfessionalGroupName" Title="Professional Group" Sortable="false" Filterable="false" />
        <RadzenDataGridColumn TItem="ProfessionalGroupCompetencyProfileDto" Property="Active" Title="Active" Width="100px" />
        <RadzenDataGridColumn TItem="ProfessionalGroupCompetencyProfileDto" Sortable="false" Filterable="false" Width="120px" TextAlign="TextAlign.Center">
            <Template Context="profile">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenForm(profile))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(profile))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<MudDialog @bind-Visible="_showForm" Options="new DialogOptions { CloseOnEscapeKey = true }">
    <TitleContent>@(_editingProfile is null ? "New profile" : "Edit profile")</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Name" Class="mb-2" />
        <MudTextField @bind-Value="_description" Label="Description" Lines="2" Class="mb-2" />

        <RadzenDropDown TValue="Guid" @bind-Value="_professionalGroupId" Data="@_professionalGroups" TextProperty="Name" ValueProperty="Id"
                        AllowVirtualization="true" AllowFiltering="true" Placeholder="Professional Group" Style="width:100%;" Class="mb-2" />

        @if (_editingProfile is not null)
        {
            <MudCheckBox @bind-Value="_active" Label="Active" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseForm">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private RadzenDataGrid<ProfessionalGroupCompetencyProfileDto>? _grid;
    private IEnumerable<ProfessionalGroupCompetencyProfileDto>? _items;
    private int _count;
    private readonly int[] _pageSizeOptions = [10, 25, 50, 100];
    private List<ProfessionalGroupDto>? _professionalGroups;

    private bool _showForm;
    private ProfessionalGroupCompetencyProfileDto? _editingProfile;
    private string _name = string.Empty;
    private string? _description;
    private Guid _professionalGroupId;
    private bool _active = true;

    protected override async Task OnInitializedAsync() => _professionalGroups = await ProfessionalGroupApi.GetAllAsync();

    private async Task LoadDataAsync(LoadDataArgs args)
    {
        var pageSize = args.Top ?? 25;
        var page = pageSize > 0 ? (args.Skip ?? 0) / pageSize + 1 : 1;
        var paged = await ProfessionalGroupCompetencyProfileApi.GetPagedAsync(page, pageSize, args.Filter, args.OrderBy);
        _items = paged.Items;
        _count = paged.TotalCount;
    }

    private void OpenForm(ProfessionalGroupCompetencyProfileDto? profile)
    {
        _editingProfile = profile;
        _name = profile?.Name ?? string.Empty;
        _description = profile?.Description;
        _professionalGroupId = profile?.ProfessionalGroupId ?? _professionalGroups?.FirstOrDefault()?.Id ?? Guid.Empty;
        _active = profile?.Active ?? true;
        _showForm = true;
    }

    private void CloseForm() => _showForm = false;

    private async Task SaveAsync()
    {
        if (_editingProfile is null)
            await ProfessionalGroupCompetencyProfileApi.CreateAsync(new CreateProfessionalGroupCompetencyProfileDto(_name, _description, _professionalGroupId));
        else
            await ProfessionalGroupCompetencyProfileApi.UpdateAsync(new UpdateProfessionalGroupCompetencyProfileDto(_editingProfile.Id, _name, _description, _professionalGroupId, _active));

        Snackbar.Add("Profile saved.", Severity.Success);
        _showForm = false;
        await ReloadGridAsync();
    }

    private async Task DeleteAsync(ProfessionalGroupCompetencyProfileDto profile)
    {
        await ProfessionalGroupCompetencyProfileApi.DeleteAsync(profile.Id);
        Snackbar.Add("Profile deleted.", Severity.Success);
        await ReloadGridAsync();
    }

    private Task ReloadGridAsync() => _grid?.Reload() ?? Task.CompletedTask;
}
