@page "/service-offerings"
@attribute [Authorize]
@inject ServiceOfferingApiClient ServiceOfferingApi
@inject ISnackbar Snackbar

<PageTitle>Service Offerings</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Service Offerings</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           Class="mb-4" OnClick="@(() => OpenForm(null))">
    New service
</MudButton>

<RadzenDataGrid @ref="_grid" TItem="ServiceOfferingDto" Data="@_items" Count="@_count" LoadData="@LoadDataAsync"
                AllowFiltering="true" AllowSorting="true" AllowPaging="true" PageSize="25"
                FilterMode="FilterMode.Simple" PageSizeOptions="@_pageSizeOptions">
    <Columns>
        <RadzenDataGridColumn TItem="ServiceOfferingDto" Property="Name" Title="Name" />
        <RadzenDataGridColumn TItem="ServiceOfferingDto" Property="Recruitment" Title="Recruitment" Width="130px" />
        <RadzenDataGridColumn TItem="ServiceOfferingDto" Property="Selection" Title="Selection" Width="130px" />
        <RadzenDataGridColumn TItem="ServiceOfferingDto" Property="Proposal" Title="Proposal" Width="130px" />
        <RadzenDataGridColumn TItem="ServiceOfferingDto" Property="Active" Title="Active" Width="100px" />
        <RadzenDataGridColumn TItem="ServiceOfferingDto" Sortable="false" Filterable="false" Width="120px" TextAlign="TextAlign.Center">
            <Template Context="offering">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenForm(offering))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(offering))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<MudDialog @bind-Visible="_showForm" Options="new DialogOptions { CloseOnEscapeKey = true }">
    <TitleContent>@(_editingOffering is null ? "New service" : "Edit service")</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Name" Class="mb-2" />
        <MudTextField @bind-Value="_description" Label="Description" Lines="2" Class="mb-2" />
        <MudCheckBox @bind-Value="_recruitment" Label="Recruitment" Class="mb-2" />
        <MudCheckBox @bind-Value="_selection" Label="Selection" Class="mb-2" />
        <MudCheckBox @bind-Value="_proposal" Label="Proposal" Class="mb-2" />

        @if (_editingOffering is not null)
        {
            <MudCheckBox @bind-Value="_active" Label="Active" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseForm">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private RadzenDataGrid<ServiceOfferingDto>? _grid;
    private IEnumerable<ServiceOfferingDto>? _items;
    private int _count;
    private readonly int[] _pageSizeOptions = [10, 25, 50, 100];

    private bool _showForm;
    private ServiceOfferingDto? _editingOffering;
    private string _name = string.Empty;
    private string? _description;
    private bool _recruitment;
    private bool _selection;
    private bool _proposal;
    private bool _active = true;

    private async Task LoadDataAsync(LoadDataArgs args)
    {
        var pageSize = args.Top ?? 25;
        var page = pageSize > 0 ? (args.Skip ?? 0) / pageSize + 1 : 1;
        var paged = await ServiceOfferingApi.GetPagedAsync(page, pageSize, args.Filter, args.OrderBy);
        _items = paged.Items;
        _count = paged.TotalCount;
    }

    private void OpenForm(ServiceOfferingDto? offering)
    {
        _editingOffering = offering;
        _name = offering?.Name ?? string.Empty;
        _description = offering?.Description;
        _recruitment = offering?.Recruitment ?? false;
        _selection = offering?.Selection ?? false;
        _proposal = offering?.Proposal ?? false;
        _active = offering?.Active ?? true;
        _showForm = true;
    }

    private void CloseForm() => _showForm = false;

    private async Task SaveAsync()
    {
        if (_editingOffering is null)
            await ServiceOfferingApi.CreateAsync(new CreateServiceOfferingDto(_name, _description, _recruitment, _selection, _proposal));
        else
            await ServiceOfferingApi.UpdateAsync(new UpdateServiceOfferingDto(_editingOffering.Id, _name, _description, _recruitment, _selection, _proposal, _active));

        Snackbar.Add("Service offering saved.", Severity.Success);
        _showForm = false;
        await ReloadGridAsync();
    }

    private async Task DeleteAsync(ServiceOfferingDto offering)
    {
        await ServiceOfferingApi.DeleteAsync(offering.Id);
        Snackbar.Add("Service offering deleted.", Severity.Success);
        await ReloadGridAsync();
    }

    private Task ReloadGridAsync() => _grid?.Reload() ?? Task.CompletedTask;
}
