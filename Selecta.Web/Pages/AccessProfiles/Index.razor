@page "/access-profiles"
@attribute [Authorize]
@inject AccessProfileApiClient AccessProfileApi
@inject ISnackbar Snackbar

<PageTitle>Access Profiles</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Access Profiles</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    Catálogo de perfis de acesso (papéis) do sistema. Sem ligação normalizada a User nesta fase —
    User.Roles continua a ser o texto livre já existente.
</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           Class="mb-4" OnClick="@(() => OpenForm(null))">
    New profile
</MudButton>

<RadzenDataGrid @ref="_grid" TItem="AccessProfileDto" Data="@_items" Count="@_count" LoadData="@LoadDataAsync"
                AllowFiltering="true" AllowSorting="true" AllowPaging="true" PageSize="25"
                FilterMode="FilterMode.Simple" PageSizeOptions="@_pageSizeOptions">
    <Columns>
        <RadzenDataGridColumn TItem="AccessProfileDto" Property="Name" Title="Name" />
        <RadzenDataGridColumn TItem="AccessProfileDto" Property="Description" Title="Description" />
        <RadzenDataGridColumn TItem="AccessProfileDto" Sortable="false" Filterable="false" Width="120px" TextAlign="TextAlign.Center">
            <Template Context="profile">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenForm(profile))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(profile))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<MudDialog @bind-Visible="_showForm" Options="new DialogOptions { CloseOnEscapeKey = true }">
    <TitleContent>@(_editingProfile is null ? "New profile" : "Edit profile")</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Name" Class="mb-2" />
        <MudTextField @bind-Value="_description" Label="Description" Lines="2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseForm">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private RadzenDataGrid<AccessProfileDto>? _grid;
    private IEnumerable<AccessProfileDto>? _items;
    private int _count;
    private readonly int[] _pageSizeOptions = [10, 25, 50, 100];

    private bool _showForm;
    private AccessProfileDto? _editingProfile;
    private string _name = string.Empty;
    private string? _description;

    private async Task LoadDataAsync(LoadDataArgs args)
    {
        var pageSize = args.Top ?? 25;
        var page = pageSize > 0 ? (args.Skip ?? 0) / pageSize + 1 : 1;
        var paged = await AccessProfileApi.GetPagedAsync(page, pageSize, args.Filter, args.OrderBy);
        _items = paged.Items;
        _count = paged.TotalCount;
    }

    private void OpenForm(AccessProfileDto? profile)
    {
        _editingProfile = profile;
        _name = profile?.Name ?? string.Empty;
        _description = profile?.Description;
        _showForm = true;
    }

    private void CloseForm() => _showForm = false;

    private async Task SaveAsync()
    {
        if (_editingProfile is null)
            await AccessProfileApi.CreateAsync(new CreateAccessProfileDto(_name, _description));
        else
            await AccessProfileApi.UpdateAsync(new UpdateAccessProfileDto(_editingProfile.Id, _name, _description));

        Snackbar.Add("Profile saved.", Severity.Success);
        _showForm = false;
        await ReloadGridAsync();
    }

    private async Task DeleteAsync(AccessProfileDto profile)
    {
        await AccessProfileApi.DeleteAsync(profile.Id);
        Snackbar.Add("Profile deleted.", Severity.Success);
        await ReloadGridAsync();
    }

    private Task ReloadGridAsync() => _grid?.Reload() ?? Task.CompletedTask;
}
