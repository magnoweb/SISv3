@page "/collaborators"
@attribute [Authorize]
@inject CollaboratorApiClient CollaboratorApi
@inject ISnackbar Snackbar

<PageTitle>Collaborators</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Collaborators</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           Class="mb-4" OnClick="@(() => OpenForm(null))">
    New collaborator
</MudButton>

<RadzenDataGrid @ref="_grid" TItem="CollaboratorDto" Data="@_items" Count="@_count" LoadData="@LoadDataAsync"
                AllowFiltering="true" AllowSorting="true" AllowPaging="true" PageSize="25"
                FilterMode="FilterMode.Simple" PageSizeOptions="@_pageSizeOptions">
    <Columns>
        <RadzenDataGridColumn TItem="CollaboratorDto" Property="Name" Title="Name" />
        <RadzenDataGridColumn TItem="CollaboratorDto" Property="Document" Title="Document" Width="160px" />
        <RadzenDataGridColumn TItem="CollaboratorDto" Property="Active" Title="Active" Width="100px" />
        <RadzenDataGridColumn TItem="CollaboratorDto" Sortable="false" Filterable="false" Width="120px" TextAlign="TextAlign.Center">
            <Template Context="collaborator">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenForm(collaborator))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(collaborator))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<MudDialog @bind-Visible="_showForm" Options="new DialogOptions { CloseOnEscapeKey = true }">
    <TitleContent>@(_editingCollaborator is null ? "New collaborator" : "Edit collaborator")</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Name" Class="mb-2" />
        <MudTextField @bind-Value="_document" Label="Document" Class="mb-2" />

        @if (_editingCollaborator is not null)
        {
            <MudCheckBox @bind-Value="_active" Label="Active" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseForm">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private RadzenDataGrid<CollaboratorDto>? _grid;
    private IEnumerable<CollaboratorDto>? _items;
    private int _count;
    private readonly int[] _pageSizeOptions = [10, 25, 50, 100];

    private bool _showForm;
    private CollaboratorDto? _editingCollaborator;
    private string _name = string.Empty;
    private string? _document;
    private bool _active = true;

    private async Task LoadDataAsync(LoadDataArgs args)
    {
        var pageSize = args.Top ?? 25;
        var page = pageSize > 0 ? (args.Skip ?? 0) / pageSize + 1 : 1;
        var paged = await CollaboratorApi.GetPagedAsync(page, pageSize, args.Filter, args.OrderBy);
        _items = paged.Items;
        _count = paged.TotalCount;
    }

    private void OpenForm(CollaboratorDto? collaborator)
    {
        _editingCollaborator = collaborator;
        _name = collaborator?.Name ?? string.Empty;
        _document = collaborator?.Document;
        _active = collaborator?.Active ?? true;
        _showForm = true;
    }

    private void CloseForm() => _showForm = false;

    private async Task SaveAsync()
    {
        if (_editingCollaborator is null)
            await CollaboratorApi.CreateAsync(new CreateCollaboratorDto(_name, _document));
        else
            await CollaboratorApi.UpdateAsync(new UpdateCollaboratorDto(_editingCollaborator.Id, _name, _document, _active));

        Snackbar.Add("Collaborator saved.", Severity.Success);
        _showForm = false;
        await ReloadGridAsync();
    }

    private async Task DeleteAsync(CollaboratorDto collaborator)
    {
        await CollaboratorApi.DeleteAsync(collaborator.Id);
        Snackbar.Add("Collaborator deleted.", Severity.Success);
        await ReloadGridAsync();
    }

    private Task ReloadGridAsync() => _grid?.Reload() ?? Task.CompletedTask;
}
