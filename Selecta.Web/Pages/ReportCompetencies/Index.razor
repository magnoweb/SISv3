@page "/report-competencies"
@attribute [Authorize]
@inject ReportCompetencyApiClient ReportCompetencyApi
@inject ReportApiClient ReportApi
@inject CompetencyApiClient CompetencyApi
@inject CompetencyDescriptorApiClient CompetencyDescriptorApi
@inject CompetencyScoreApiClient CompetencyScoreApi
@inject ISnackbar Snackbar

<PageTitle>Report Competencies</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Report Competencies</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    Linhas de competência de um <MudLink Href="/reports">Report</MudLink> — pontuação esperada (perfil) vs. obtida.
</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           Class="mb-4" OnClick="@(() => OpenForm(null))" Disabled="!CanCreate">
    New line
</MudButton>

@if (!CanCreate && _referenceDataLoaded)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Precisas de pelo menos um <MudLink Href="/reports">Report</MudLink> e uma
        <MudLink Href="/competencies">Competency</MudLink> cadastrados.
    </MudAlert>
}

<RadzenDataGrid @ref="_grid" TItem="ReportCompetencyDto" Data="@_items" Count="@_count" LoadData="@LoadDataAsync"
                AllowFiltering="true" AllowSorting="true" AllowPaging="true" PageSize="25"
                FilterMode="FilterMode.Simple" PageSizeOptions="@_pageSizeOptions">
    <Columns>
        <RadzenDataGridColumn TItem="ReportCompetencyDto" Property="CompetencyName" Title="Competency" Sortable="false" Filterable="false" />
        <RadzenDataGridColumn TItem="ReportCompetencyDto" Property="ProfileScoreName" Title="Profile score" Sortable="false" Filterable="false" />
        <RadzenDataGridColumn TItem="ReportCompetencyDto" Property="ScoreName" Title="Score" Sortable="false" Filterable="false" />
        <RadzenDataGridColumn TItem="ReportCompetencyDto" Property="Percentage" Title="Percentage" Width="130px" />
        <RadzenDataGridColumn TItem="ReportCompetencyDto" Sortable="false" Filterable="false" Width="120px" TextAlign="TextAlign.Center">
            <Template Context="item">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenForm(item))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(item))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<MudDialog @bind-Visible="_showForm" Options="new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>@(_editingItem is null ? "New line" : "Edit line")</TitleContent>
    <DialogContent>
        <RadzenDropDown TValue="Guid" @bind-Value="_reportId" Data="@_reports" TextProperty="CandidateName" ValueProperty="Id"
                        AllowVirtualization="true" AllowFiltering="true" Placeholder="Report" Style="width:100%;" Class="mb-2">
            <Template Context="item">
                @($"{item.CandidateName} ({item.ReportTemplateName})")
            </Template>
        </RadzenDropDown>

        <RadzenDropDown TValue="Guid" @bind-Value="_competencyId" Data="@_competencies" TextProperty="Name" ValueProperty="Id"
                        AllowVirtualization="true" AllowFiltering="true" Placeholder="Competency" Style="width:100%;" Class="mb-2" />

        <RadzenDropDown TValue="Guid?" @bind-Value="_competencyDescriptorId" Data="@_competencyDescriptors" TextProperty="Name" ValueProperty="Id"
                        AllowVirtualization="true" AllowFiltering="true" AllowClear="true" Placeholder="Descriptor (optional)" Style="width:100%;" Class="mb-2" />

        <RadzenDropDown TValue="Guid?" @bind-Value="_profileScoreId" Data="@_competencyScores" TextProperty="Name" ValueProperty="Id"
                        AllowVirtualization="true" AllowFiltering="true" AllowClear="true" Placeholder="Profile score (expected, optional)" Style="width:100%;" Class="mb-2">
            <Template Context="item">
                @($"{item.Name} ({item.Acronym})")
            </Template>
        </RadzenDropDown>

        <RadzenDropDown TValue="Guid?" @bind-Value="_scoreId" Data="@_competencyScores" TextProperty="Name" ValueProperty="Id"
                        AllowVirtualization="true" AllowFiltering="true" AllowClear="true" Placeholder="Score (obtained, optional)" Style="width:100%;" Class="mb-2">
            <Template Context="item">
                @($"{item.Name} ({item.Acronym})")
            </Template>
        </RadzenDropDown>

        <MudNumericField @bind-Value="_percentage" Label="Percentage" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseForm">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private RadzenDataGrid<ReportCompetencyDto>? _grid;
    private IEnumerable<ReportCompetencyDto>? _items;
    private int _count;
    private readonly int[] _pageSizeOptions = [10, 25, 50, 100];
    private bool _referenceDataLoaded;

    private List<ReportDto>? _reports;
    private List<CompetencyDto>? _competencies;
    private List<CompetencyDescriptorDto>? _competencyDescriptors;
    private List<CompetencyScoreDto>? _competencyScores;

    private bool CanCreate => _reports is { Count: > 0 } && _competencies is { Count: > 0 };

    private bool _showForm;
    private ReportCompetencyDto? _editingItem;
    private Guid _reportId;
    private Guid _competencyId;
    private Guid? _competencyDescriptorId;
    private Guid? _profileScoreId;
    private Guid? _scoreId;
    private int? _percentage;

    protected override async Task OnInitializedAsync()
    {
        _reports = await ReportApi.GetAllAsync();
        _competencies = await CompetencyApi.GetAllAsync();
        _competencyDescriptors = await CompetencyDescriptorApi.GetAllAsync();
        _competencyScores = await CompetencyScoreApi.GetAllAsync();
        _referenceDataLoaded = true;
    }

    private async Task LoadDataAsync(LoadDataArgs args)
    {
        var pageSize = args.Top ?? 25;
        var page = pageSize > 0 ? (args.Skip ?? 0) / pageSize + 1 : 1;
        var paged = await ReportCompetencyApi.GetPagedAsync(page, pageSize, args.Filter, args.OrderBy);
        _items = paged.Items;
        _count = paged.TotalCount;
    }

    private void OpenForm(ReportCompetencyDto? item)
    {
        _editingItem = item;
        _reportId = item?.ReportId ?? _reports?.FirstOrDefault()?.Id ?? Guid.Empty;
        _competencyId = item?.CompetencyId ?? _competencies?.FirstOrDefault()?.Id ?? Guid.Empty;
        _competencyDescriptorId = item?.CompetencyDescriptorId;
        _profileScoreId = item?.ProfileScoreId;
        _scoreId = item?.ScoreId;
        _percentage = item?.Percentage;
        _showForm = true;
    }

    private void CloseForm() => _showForm = false;

    private async Task SaveAsync()
    {
        if (_editingItem is null)
            await ReportCompetencyApi.CreateAsync(new CreateReportCompetencyDto(_reportId, _competencyId, _competencyDescriptorId, _profileScoreId, _scoreId, _percentage));
        else
            await ReportCompetencyApi.UpdateAsync(new UpdateReportCompetencyDto(_editingItem.Id, _reportId, _competencyId, _competencyDescriptorId, _profileScoreId, _scoreId, _percentage));

        Snackbar.Add("Line saved.", Severity.Success);
        _showForm = false;
        await ReloadGridAsync();
    }

    private async Task DeleteAsync(ReportCompetencyDto item)
    {
        await ReportCompetencyApi.DeleteAsync(item.Id);
        Snackbar.Add("Line deleted.", Severity.Success);
        await ReloadGridAsync();
    }

    private Task ReloadGridAsync() => _grid?.Reload() ?? Task.CompletedTask;
}
