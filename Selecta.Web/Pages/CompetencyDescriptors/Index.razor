@page "/competency-descriptors"
@attribute [Authorize]
@inject CompetencyDescriptorApiClient CompetencyDescriptorApi
@inject CompetencyApiClient CompetencyApi
@inject UserApiClient UserApi
@inject ISnackbar Snackbar

<PageTitle>Competency Descriptors</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Competency Descriptors</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           Class="mb-4" OnClick="@(() => OpenForm(null))" Disabled="!CanCreate">
    New descriptor
</MudButton>

@if (!CanCreate && _referenceDataLoaded)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Precisas de pelo menos uma <MudLink Href="/competencies">Competency</MudLink> cadastrada.
    </MudAlert>
}

<RadzenDataGrid @ref="_grid" TItem="CompetencyDescriptorDto" Data="@_items" Count="@_count" LoadData="@LoadDataAsync"
                AllowFiltering="true" AllowSorting="true" AllowPaging="true" PageSize="25"
                FilterMode="FilterMode.Simple" PageSizeOptions="@_pageSizeOptions">
    <Columns>
        <RadzenDataGridColumn TItem="CompetencyDescriptorDto" Property="Name" Title="Name" />
        <RadzenDataGridColumn TItem="CompetencyDescriptorDto" Property="CompetencyName" Title="Competency" Sortable="false" Filterable="false" />
        <RadzenDataGridColumn TItem="CompetencyDescriptorDto" Property="UserName" Title="Author" Sortable="false" Filterable="false" />
        <RadzenDataGridColumn TItem="CompetencyDescriptorDto" Property="Active" Title="Active" Width="100px" />
        <RadzenDataGridColumn TItem="CompetencyDescriptorDto" Sortable="false" Filterable="false" Width="120px" TextAlign="TextAlign.Center">
            <Template Context="descriptor">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenForm(descriptor))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(descriptor))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<MudDialog @bind-Visible="_showForm" Options="new DialogOptions { CloseOnEscapeKey = true }">
    <TitleContent>@(_editingDescriptor is null ? "New descriptor" : "Edit descriptor")</TitleContent>
    <DialogContent>
        <RadzenDropDown TValue="Guid" @bind-Value="_competencyId" Data="@_competencies" TextProperty="Name" ValueProperty="Id"
                        AllowVirtualization="true" AllowFiltering="true" Placeholder="Competency" Style="width:100%;" Class="mb-2" />

        <RadzenDropDown TValue="Guid" @bind-Value="_userId" Data="@_users" TextProperty="Name" ValueProperty="Id"
                        AllowVirtualization="true" AllowFiltering="true" Placeholder="Author" Style="width:100%;" Class="mb-2" />

        <MudTextField @bind-Value="_name" Label="Name" MaxLength="20" Class="mb-2" />

        @if (_editingDescriptor is not null)
        {
            <MudCheckBox @bind-Value="_active" Label="Active" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseForm">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private RadzenDataGrid<CompetencyDescriptorDto>? _grid;
    private IEnumerable<CompetencyDescriptorDto>? _items;
    private int _count;
    private readonly int[] _pageSizeOptions = [10, 25, 50, 100];
    private bool _referenceDataLoaded;

    private List<CompetencyDto>? _competencies;
    private List<UserDto>? _users;

    private bool CanCreate => _competencies is { Count: > 0 } && _users is { Count: > 0 };

    private bool _showForm;
    private CompetencyDescriptorDto? _editingDescriptor;
    private Guid _competencyId;
    private Guid _userId;
    private string _name = string.Empty;
    private bool _active = true;

    protected override async Task OnInitializedAsync()
    {
        _competencies = await CompetencyApi.GetAllAsync();
        _users = await UserApi.GetAllAsync();
        _referenceDataLoaded = true;
    }

    private async Task LoadDataAsync(LoadDataArgs args)
    {
        var pageSize = args.Top ?? 25;
        var page = pageSize > 0 ? (args.Skip ?? 0) / pageSize + 1 : 1;
        var paged = await CompetencyDescriptorApi.GetPagedAsync(page, pageSize, args.Filter, args.OrderBy);
        _items = paged.Items;
        _count = paged.TotalCount;
    }

    private void OpenForm(CompetencyDescriptorDto? descriptor)
    {
        _editingDescriptor = descriptor;
        _competencyId = descriptor?.CompetencyId ?? _competencies?.FirstOrDefault()?.Id ?? Guid.Empty;
        _userId = descriptor?.UserId ?? _users?.FirstOrDefault()?.Id ?? Guid.Empty;
        _name = descriptor?.Name ?? string.Empty;
        _active = descriptor?.Active ?? true;
        _showForm = true;
    }

    private void CloseForm() => _showForm = false;

    private async Task SaveAsync()
    {
        if (_editingDescriptor is null)
            await CompetencyDescriptorApi.CreateAsync(new CreateCompetencyDescriptorDto(_competencyId, _userId, _name));
        else
            await CompetencyDescriptorApi.UpdateAsync(new UpdateCompetencyDescriptorDto(_editingDescriptor.Id, _competencyId, _userId, _name, _active));

        Snackbar.Add("Descriptor saved.", Severity.Success);
        _showForm = false;
        await ReloadGridAsync();
    }

    private async Task DeleteAsync(CompetencyDescriptorDto descriptor)
    {
        await CompetencyDescriptorApi.DeleteAsync(descriptor.Id);
        Snackbar.Add("Descriptor deleted.", Severity.Success);
        await ReloadGridAsync();
    }

    private Task ReloadGridAsync() => _grid?.Reload() ?? Task.CompletedTask;
}
